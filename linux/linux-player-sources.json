    "required": ["--disable-gpl", "--disable-nonfree", "--disable-autodetect", "--enable-shared", "--disable-static", "--disable-programs", "--disable-doc", "--enable-gnutls", "--enable-libdav1d", "--enable-zlib", "--enable-iconv", "--enable-vaapi", "--enable-libdrm"],
    "forbidden": ["--enable-version3", "--enable-gpl", "--enable-nonfree", "--enable-gmp", "--enable-openssl", "--enable-libsmbclient", "--enable-libx264", "--enable-libx265", "--enable-postproc", "--enable-mbedtls"]
  },
  "mpv_options": {
    "required": ["-Dlibmpv=true", "-Dcplayer=false", "-Dgpl=false", "-Db_lundef=true", "-Dauto_features=disabled", "-Dlua=disabled",
                 "-Diconv=enabled", "-Duchardet=enabled", "-Dlibbluray=enabled", "-Dlcms2=enabled", "-Dzlib=enabled", "-Dlibavdevice=enabled",
                 "-Dgl=enabled", "-Dplain-gl=enabled", "-Degl=enabled", "-Ddrm=enabled", "-Dvaapi=enabled", "-Dvaapi-drm=enabled",
                 "-Dpulse=enabled", "-Dalsa=enabled"],
    "notes": "mpv's X11 backend is GPL-only (meson: x11 requires gpl), so VA-API uses its DRM display (vaapi-drm, which needs drm and libdisplay-info); the render API draws into alkemyo's own GL surface and needs no mpv window. PipeWire needs libpipewire >= 0.3.57 and Ubuntu 22.04 has 0.3.48, so audio goes through PulseAudio (pipewire-pulse on PipeWire systems) or ALSA."
  },
  "libplacebo_options": ["-Dvulkan=disabled", "-Dopengl=enabled", "-Dd3d11=disabled", "-Dlcms=enabled", "-Dxxhash=disabled", "-Dshaderc=disabled", "-Dglslang=disabled", "-Ddovi=disabled", "-Dlibdovi=disabled", "-Ddemos=false", "-Dtests=false", "-Dunwind=disabled"],
  "bundled": ["libavcodec", "libavdevice", "libavfilter", "libavformat", "libavutil", "libswresample", "libswscale", "libmpv", "libplacebo", "libdav1d", "libdisplay-info"],
  "forbidden_needed": ["libX11", "libpipewire-0.3", "libx264", "libx265", "libpostproc", "libssl", "libcrypto", "libmbedtls", "libsmbclient", "libluajit", "liblua", "libvulkan", "libshaderc", "libglslang"]
